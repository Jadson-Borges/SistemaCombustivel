@page "/Error"
@using System.Diagnostics

<PageTitle>Erro</PageTitle>

<div class="alert alert-danger" role="alert">
    <h1 class="h4 alert-heading">Ocorreu um erro</h1>
    <p class="mb-0">Não foi possível processar a sua solicitação. Tente novamente em instantes.</p>
</div>

@if (ShowRequestId)
{
    <p class="text-muted small">Código da requisição: <code>@RequestId</code></p>
}

<a class="btn btn-primary" href="/">Voltar para o início</a>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}