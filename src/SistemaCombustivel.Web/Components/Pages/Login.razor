@page "/login"
@using System.ComponentModel.DataAnnotations
@using SistemaCombustivel.Application.Usuarios.Commands.LoginUsuario
@inject LoginUsuarioCommandHandler LoginUsuario
@inject NavigationManager NavigationManager

<PageTitle>Entrar</PageTitle>

<div class="row justify-content-center">
    <div class="col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-4">Entrar</h1>

                @if (mensagemErro is not null)
                {
                    <div class="alert alert-danger" role="alert">@mensagemErro</div>
                }

                <EditForm Model="@modelo" OnValidSubmit="HandleLogin" FormName="loginForm">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label for="email" class="form-label">E-mail</label>
                        <InputText id="email" class="form-control" autocomplete="username"
                                   @bind-Value="modelo!.Email" />
                        <ValidationMessage For="@(() => modelo!.Email)" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label for="senha" class="form-label">Senha</label>
                        <InputText id="senha" class="form-control" type="password" autocomplete="current-password"
                                   @bind-Value="modelo!.Senha" />
                        <ValidationMessage For="@(() => modelo!.Senha)" class="text-danger small" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Entrar</button>
                </EditForm>

                <p class="text-center text-muted mt-3 mb-0">
                    Não tem conta? <a href="/registrar">Registre-se aqui</a>
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private ModeloLogin? modelo { get; set; }

    private string? mensagemErro;

    protected override void OnInitialized() => modelo ??= new();

    private async Task HandleLogin()
    {
        var resultado = await LoginUsuario.Handle(
            new LoginUsuarioCommand(modelo!.Email, modelo.Senha), CancellationToken.None);

        if (!resultado.Sucesso)
        {
            mensagemErro = resultado.Erro;
            return;
        }

        NavigationManager.NavigateTo("/", forceLoad: true);
    }

    public class ModeloLogin
    {
        [Required(ErrorMessage = "Informe o e-mail")]
        [EmailAddress(ErrorMessage = "E-mail inválido")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe a senha")]
        public string Senha { get; set; } = string.Empty;
    }
}