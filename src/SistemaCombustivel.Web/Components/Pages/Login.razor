@page "/login"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using SistemaCombustivel.Application.Usuarios.Commands.LoginUsuario
@inject LoginUsuarioCommandHandler LoginUsuario
@inject NavigationManager NavigationManager

<PageTitle>Entrar | Rota+</PageTitle>

<div class="auth-page">
    <section class="auth-visual">
        <a class="brand-lockup auth-brand" href="/login" aria-label="Rota+ - página de acesso">
            <img class="brand-logo" src="@Assets["images/logo-combustivel.jpg"]" alt="" />
            <span class="brand-copy"><strong>ROTA<span>+</span></strong><small>GESTÃO DE COMBUSTÍVEL</small></span>
        </a>
        <div class="auth-visual-content">
            <span class="eyebrow eyebrow-light"><span class="eyebrow-line"></span> GESTÃO INTELIGENTE</span>
            <h1>Sua operação em movimento. <span>Suas decisões sob controle.</span></h1>
            <p>Organize veículos, acompanhe rotas e entenda as despesas da operação em um só lugar.</p>
        </div>
        <span class="auth-copyright">CONTROLE QUE MOVE SUA EMPRESA.</span>
    </section>

    <section class="auth-form-side">
        <div class="auth-form-wrap animate-enter">
            <span class="form-step-label"><i></i> ACESSO SEGURO</span>
            <h2>Bem-vindo de volta<span>.</span></h2>
            <p class="auth-subtitle">Entre com seus dados para acessar o painel.</p>

            @if (mensagemErro is not null)
            {
                <div class="alert alert-danger" role="alert">@mensagemErro</div>
            }

            <EditForm Model="@modelo" OnValidSubmit="HandleLogin" FormName="loginForm" class="auth-form">
                <DataAnnotationsValidator />

                <div class="form-field">
                    <label for="email">E-mail</label>
                    <div class="input-shell">
                        <i class="bi bi-envelope input-icon" aria-hidden="true"></i>
                        <InputText id="email" class="form-control" autocomplete="username"
                                   placeholder="Seu e-mail" @bind-Value="modelo!.Email" />
                    </div>
                    <ValidationMessage For="@(() => modelo!.Email)" class="text-danger small" />
                </div>

                <div class="form-field">
                    <label for="senha">Senha</label>
                    <div class="input-shell">
                        <i class="bi bi-lock input-icon" aria-hidden="true"></i>
                        <InputText id="senha" class="form-control" type="password" autocomplete="current-password"
                                   placeholder="Digite sua senha" @bind-Value="modelo!.Senha" />
                    </div>
                    <ValidationMessage For="@(() => modelo!.Senha)" class="text-danger small" />
                </div>

                <button type="submit" class="btn btn-primary btn-primary-custom w-100">
                    Entrar no sistema <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </button>
            </EditForm>

            <p class="auth-security"><i class="bi bi-person-lock" aria-hidden="true"></i> A criação de contas é gerenciada por um administrador do sistema.</p>
        </div>
    </section>
</div>

@code {
    [SupplyParameterFromForm]
    private ModeloLogin? modelo { get; set; }

    private string? mensagemErro;

    protected override void OnInitialized() => modelo ??= new();

    private async Task HandleLogin()
    {
        var resultado = await LoginUsuario.Handle(
            new LoginUsuarioCommand(modelo!.Email, modelo.Senha), CancellationToken.None);

        if (!resultado.Sucesso)
        {
            mensagemErro = resultado.Erro;
            return;
        }

        NavigationManager.NavigateTo("/", forceLoad: true);
    }

    public class ModeloLogin
    {
        [Required(ErrorMessage = "Informe o e-mail")]
        [EmailAddress(ErrorMessage = "E-mail inválido")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe a senha")]
        public string Senha { get; set; } = string.Empty;
    }
}