@using SistemaCombustivel.Application.Common
@inherits LayoutComponentBase

<nav class="navbar navbar-expand-md bg-dark" data-bs-theme="dark">
    <div class="container">
        <a class="navbar-brand" href="/">Sistema Combustível</a>

        <AuthorizeView>
            <Authorized>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#menuPrincipal" aria-controls="menuPrincipal"
                        aria-expanded="false" aria-label="Alternar menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="menuPrincipal">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">Início</NavLink>
                        </li>

                        <AuthorizeView Policy="@Autorizacao.PoliticaAdministrador" Context="admin">
                            <li class="nav-item">
                                <NavLink class="nav-link" href="/admin">Administração</NavLink>
                            </li>
                        </AuthorizeView>
                    </ul>

                    <span class="navbar-text me-3">@context.User.Identity?.Name</span>

                    <form method="post" action="/logout" class="d-flex">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="login" />
                        <button type="submit" class="btn btn-outline-light btn-sm">Sair</button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
</nav>

<main class="container py-4">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro inesperado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">🗙</span>
</div>